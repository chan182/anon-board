rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['category', 'preview', 'truncated', 'createdAt'])
                    && request.resource.data.category in ['boss', 'relationship', 'friend', 'etc']
                    && request.resource.data.preview is string
                    && request.resource.data.preview.size() <= 10
                    && request.resource.data.truncated is bool
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['content', 'createdAt'])
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 300
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /post_full/{postId} {
      // Temporarily public while the site is under AdSense review; tighten to
      // `request.auth != null` once the sign-up content gate is re-enabled.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['content', 'createdAt'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 1000
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['postId', 'createdAt'])
                    && request.resource.data.postId is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
